// Tier 1, chapter 1: kinematics. Words only; the numbers are generated per save.
Chapter(
    id: "1.1",
    tier: 1,
    domain: Mechanics,
    title: "The Salvage Launcher",
    part: "Skiff frame",
    intro: "The frame beam for the skiff lies at the wreck, on the wrong side of a canyon and a ridge. The old cargo launchers still work. They will throw anything, exactly as fast and as steep as you tell them to.",
    goal: "Get the frame beam from the wreck to the shipyard: across the canyon, over the ridge.",
    // Lumen's words. Spoken, so no digits; `look` is a place its eye holds while it speaks.
    opening: [
        Spoken(text: "Lumen here, the ship's computer. Some of me: a backup, on this section's cells. I can see, but I have no hands. Those are yours."),
        Spoken(text: "That is the main hull, across the strait. The rest of me is in it, and what we need to leave. We need a boat.", look: Some("The main hull, across the strait")),
        Spoken(text: "A boat starts with a frame. Its beam is here, the shipyard past the canyon and the ridge. The old launchers can throw it, once they can aim."),
    ],
    closing: [
        Spoken(text: "That is the whole frame. Come and see it on the shipyard floor.", look: Some("The shipyard floor")),
    ],
    remarks: [
        Remark(near: "The wreck", radius: 7.0, when: Always, line: Spoken(text: "That was the forward section. This backup of me lives in what is left of it.")),
        Remark(near: "The shore", radius: 10.0, when: After("1.1.0"), line: Spoken(text: "Still nothing from over there. The core is cold, or my receiver is.", look: Some("The main hull, across the strait"))),
        Remark(near: "Ledge launcher: release point", radius: 8.0, when: Before("1.1.3"), line: Spoken(text: "A long way down. Nobody is walking a beam across that.")),
        Remark(near: "Ridge: foot, near side", radius: 8.0, when: Before("1.1.4"), line: Spoken(text: "The shipyard is just over this. Close enough to see, too steep to carry anything up.")),
        Remark(near: "The shipyard floor", radius: 12.0, when: Before("1.1.4"), line: Spoken(text: "This is where the skiff goes together. For now it is a floor.")),
        Remark(near: "The shipyard floor", radius: 12.0, when: After("1.1.4"), line: Spoken(text: "A frame, not a boat yet. It needs power and a hull before it can cross. The rest of me can wait.", look: Some("The main hull, across the strait"))),
    ],
    concepts: [
        Concept(
            id: "units",
            title: "Measurements carry units",
            found: FirstCommit("1.1.0"),
            hint: "Enter a value at the supply rail station and commit it.",
            card: "A measurement is a number and a unit together. 12 m is a length, 1.5 s is a time; the number 12 on its own says neither.\n\nEvery value you enter at a station must have the kind of unit it asks for. Type the unit after the number (12 m), or use a reading from the notebook by its name (d1): the notebook keeps the unit with the number. A value of the wrong kind is refused before anything runs, and a refusal costs no charge.",
        ),
        Concept(
            id: "velocity",
            title: "Velocity",
            found: Demo("1.1.1"),
            hint: "Watch the crawler and the haul cart set off: try the experiment at the Catch the crawler station.",
            card: "Velocity is how fast a position changes, and which way. Over a stretch of motion it is the distance covered over the time taken:\n\n    v = (change in x) / (change in t)\n\nIt is a length over a time, in m/s. An object at a steady velocity covers equal distances in equal times, so its position grows in equal steps:\n\n    x = x0 + v t\n\nwhere x0 is where it was when the clock started.",
        ),
        Concept(
            id: "relative_velocity",
            title: "Relative velocity",
            found: Demo("1.1.1"),
            hint: "Watch the crawler and the haul cart set off: try the experiment at the Catch the crawler station.",
            card: "Two things moving the same way along a line at steady velocities v1 and v2: the gap between them changes at the difference,\n\n    v1 - v2\n\nthe velocity of one as seen from the other. It grows by the same amount every second, or shrinks if the one behind is the faster. Moving towards each other, they close at v1 + v2.\n\nA gap D between a chaser and what it chases closes in the time\n\n    t = D / (v1 - v2)",
        ),
        Concept(
            id: "free_fall",
            title: "Free fall",
            found: Demo("1.1.2"),
            hint: "Watch the test mass fall from the drop tower: try the experiment at the Local gravity station.",
            card: "An object released from rest and pulled only by gravity gains speed at a steady rate g, the gravitational acceleration. After a time t it has fallen\n\n    h = (1/2) g t^2\n\nThe mass of the object does not appear: heavy and light things fall together. g belongs to the planet, and this is not the planet you learned the number for.",
        ),
        Concept(
            id: "independence",
            title: "Horizontal and vertical motion are independent",
            found: Demo("1.1.3"),
            hint: "Watch the two test crates leave the ledge: try the experiment at the Across the canyon station.",
            card: "A thrown object does two things at once and neither affects the other.\n\n    sideways: nothing pushes it, so its horizontal speed stays constant     x = vx t\n    vertically: gravity acts exactly as in free fall                        y = vy t - (1/2) g t^2\n\nA crate fired horizontally off a ledge and a crate simply dropped from the same ledge reach the ground at the same moment.",
        ),
        Concept(
            id: "components",
            title: "Splitting a launch into components",
            found: Demo("1.1.4"),
            hint: "Watch the two test slugs: try the experiment at the Over the ridge station.",
            card: "A launch at speed v and angle theta above the horizontal has\n\n    vx = v cos(theta)        vy = v sin(theta)\n\nSteeper means more of the speed goes into height and time in the air, less into covering ground.",
        ),
        Concept(
            id: "range",
            title: "Range on level ground",
            found: Demo("1.1.4"),
            hint: "Watch the two test slugs: try the experiment at the Over the ridge station.",
            card: "If launch and landing are at the same height, the time in the air is t = 2 v sin(theta) / g, and in that time the object travels\n\n    R = v^2 sin(2 theta) / g\n\nTwo different angles give the same range: a flat one and a steep one, equally far either side of 45 degrees. They are not the same path.",
        ),
    ],
    puzzles: [
        PuzzleDef(
            id: "1.1.0",
            kind: Rail,
            title: "The supply rail",
            task: "Load the rail cart and send it to the orange marker.",
            why: "The first crate out of the wreck: tools for the launchers. Nothing hard here; this is how every station works.",
            done: "Tools are out. Now the launchers need something to aim with.",
            brief: "Every job on this island runs through a station like this one: read what is needed, measure the world, enter values, commit, and watch what happens.\n\nStart with something that needs no physics. The supply rail by the wreck carries a cart, and its motor drives the cart exactly as far as you tell it, then stops. Load it, then send it to the orange marker across the rail.\n\nThe cart will not run empty. Its cargo, a crate of tools for the launchers, stands beside the rail: leave the console, walk up to the crate and pick it up with F, then face the cart and put it on with F. Salvage with an orange handle can be carried this way all over the island.\n\nEach test uses one of the station's prototype charges. When they run out the station recharges, which takes a while, so measure before you commit.",
            investigate: "Ruler (R): click the cart's starting point, then the marker's centre (yellow pins mark both), and note the horizontal distance. It goes into the notebook (N) under a short name such as d1. Enter that name, or the number with its unit, in the blueprint below. Try the number without a unit first if you like: the station refuses it and says why, and no charge is used.",
            concepts: ["units"],
            requires: [],
            charges: 3,
        ),
        PuzzleDef(
            id: "1.1.1",
            kind: Chase,
            title: "Catch the crawler",
            task: "Send the haul cart to reach the crawler on the transfer marker.",
            why: "That crawler carries the launchers' guidance unit, and the crash shook its drive awake. Without that unit, nothing here can aim.",
            done: "The guidance unit is on the crane. It can aim, once it knows how hard this planet pulls.",
            brief: "A survey crawler from the wreck still runs along the haul track, carrying the launchers' guidance unit: the box that aims them. Its drive has one setting: it runs at one steady speed from the moment it starts, and nothing here can stop or steer it.\n\nThe haul cart stands behind it on the same track and runs at whatever speed you set. When it reaches the crawler the two couple, and only the crane at the transfer marker can lift the load off. Set the cart's speed so that it reaches the crawler on the marker.\n\nWhen you commit, the crawler and the cart set off from their marks at the same moment.",
            investigate: "Ruler (R): click the haul cart's front coupler, then the crawler's rear coupler, for the crawler's head start; then the cart's front coupler and the transfer marker's centre. The two couplers meet when the cart reaches the crawler. Click the tops of the two timing posts beside the track for the distance between them.\n\nStopwatch: every run of the experiment below times the crawler from the first timing post to the second and notes it (such as t1). The crawler's speed is not written anywhere: work it out from what you measure.",
            concepts: ["velocity", "relative_velocity"],
            requires: ["1.1.0"],
            charges: 3,
            demo: Some(DemoDef(
                question: "The crawler and the haul cart leave their marks at the same moment, the cart at a lower steady speed. A flash marks both at equal moments. How does the gap between them change?",
                choices: [
                    "It grows by the same amount every moment.",
                    "It grows faster and faster.",
                    "It stays the same: both are moving.",
                ],
                answer: 0,
                reveal: "The gap grows by the same amount every moment. Each of them covers equal distances in equal times, and the crawler covers more, so the gap grows at the difference of their speeds. Behind a slower crawler, a faster cart would close it at that difference instead.",
            )),
        ),
        PuzzleDef(
            id: "1.1.2",
            kind: Gravity,
            title: "Local gravity",
            task: "Measure this planet's gravitational acceleration.",
            why: "The guidance unit only knows home's gravity. So do I: this backup carries home's tables. I would rather have your number than my guess.",
            done: "Your g is in the guidance unit now, and in me. Every shot from here on is worked out with it.",
            brief: "The guidance unit was calibrated for another world. Before the launchers can aim, it needs the gravitational acceleration here.\n\nThe drop tower beside this station holds a test mass. Measure how far it falls and how long that takes. When you commit a value, a second mass is released from the taller survey mast and timed against your prediction.",
            investigate: "Ruler (R): click the release point at the top of the drop tower, then the landing plate below it. Stopwatch: every run of the experiment below times the fall and notes it.\n\nLight gate: the gate on the stand by this station can be carried (F) and clamped on the drop tower at any whole-metre notch, from a metre below the release down to the plate: point at the height on the tower and press F. With a gate fitted, each run times the fall from the release to the gate and notes the drop and the time as a pair with one number (such as h2 and t2). The stopwatch reads to hundredths of a second, so a short drop gives a rough value: the longer the drop, the better the reading.",
            concepts: ["free_fall"],
            requires: ["1.1.1"],
            charges: 3,
            demo: Some(DemoDef(
                question: "The test mass is released from the top of the drop tower. A flash marks where it is at equal moments as it falls. How will the marks be spaced?",
                choices: [
                    "Evenly: it falls at a steady speed.",
                    "Further apart lower down: it keeps speeding up.",
                    "Closer together lower down: it slows as it falls.",
                ],
                answer: 1,
                reveal: "The gaps grow all the way down: in each moment the mass falls further than in the moment before. It gains speed at a steady rate, and that rate is the planet's gravitational acceleration.",
            )),
        ),
        PuzzleDef(
            id: "1.1.3",
            kind: Canyon,
            title: "Across the canyon",
            task: "Land the cradle's crate on the platform across the canyon.",
            why: "The beam needs a cradle to land in, and the cradle has to cross the canyon first. Our first real shot with your g.",
            done: "The cradle made it across. It is waiting on the shipyard floor.",
            brief: "The frame beam's cradle, packed in a salvage crate, has to reach the shipyard side. This launcher sits on the canyon's high rim and fires horizontally. The orange strip on the far side is where the crate has to land: one block long, so it takes a worked-out shot, not a lucky one.\n\nIts speed dial was damaged in the crash and turns only within a band, printed on the rating plate. From the bare ledge, no speed in that band reaches the strip. The launcher rides in a jack frame at the rim, and every crate slid into the frame raises it one metre.\n\nWork out how high the launcher must stand for a speed in the band to do, and build it: pick up a crate on the ledge with F, carry it to the frame and put it in with F (F at the frame takes one back out). Then set the speed for the height you built, and commit.",
            investigate: "Ruler (R): click the launcher's release point, then the centre of the strip. The ruler reports the horizontal and the vertical separation; the release point rises with the launcher. The rating plate on the station gives the dial's band: note it.",
            concepts: ["free_fall", "independence"],
            requires: ["1.1.2"],
            charges: 3,
            demo: Some(DemoDef(
                question: "Two test crates leave the ledge at the same moment: one is simply dropped, the other is fired straight out sideways. Which reaches the canyon floor first?",
                choices: [
                    "The dropped crate.",
                    "The fired crate.",
                    "Both at the same moment.",
                ],
                answer: 2,
                reveal: "They land together. Firing a crate sideways gives it no downward speed, so it falls exactly like the dropped one while it travels across.",
            )),
        ),
        PuzzleDef(
            id: "1.1.4",
            kind: Ridge,
            title: "Over the ridge",
            task: "Launch the frame beam over the ridge onto the shipyard pad.",
            why: "This is the one that matters: the frame beam itself, over the ridge to the shipyard.",
            done: "The beam is on the pad. That is a skiff's frame.",
            brief: "The shipyard pad is on level ground beyond the ridge. This launcher can tilt, but it has a rated maximum speed and will refuse anything faster.\n\nThe beam must pass over the ridge and come down on the pad. Set the launch angle and the launch speed. Leave some margin over the ridge: the beam is not a point.",
            investigate: "Ruler (R): measure from the release point to the pad centre, and to the top of the ridge on the side facing you.",
            concepts: ["components", "range", "independence"],
            requires: ["1.1.3"],
            charges: 3,
            demo: Some(DemoDef(
                question: "Two test slugs are fired from the tilting launcher at the same speed, one at 30 degrees and one at 60 degrees. Which lands further away?",
                choices: [
                    "The 30 degree shot.",
                    "The 60 degree shot.",
                    "They land in the same place.",
                ],
                answer: 2,
                reveal: "They land in the same place. The steep shot climbs higher and stays up longer but covers less ground each second; the flat one is quicker but comes down sooner. A flat and a steep angle can share a range.",
            )),
        ),
    ],
)
